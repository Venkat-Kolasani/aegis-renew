# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aegis
OPENAI_API_KEY=<set-in-local-env>

# Frontend-to-backend connection
# Browser calls same-origin /aegis-api/* (Next rewrite). Server-only rewrite target:
AEGIS_API_ORIGIN=http://localhost:8000
# Optional legacy public URL (not used by MandateSetup; prefer AEGIS_API_ORIGIN):
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Prava sandbox - never expose the secret key to the browser
PRAVA_SANDBOX_BASE_URL=https://sandbox.api.prava.space
PRAVA_PUBLISHABLE_KEY=<pk_test_from_prava>
PRAVA_SECRET_KEY=<sk_test_from_prava>
